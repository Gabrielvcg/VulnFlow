POSTGRES_DB=vulnflow
POSTGRES_USER=vulnflow
POSTGRES_PASSWORD=local-vulnflow-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
VULNFLOW_MAX_FILE_SIZE=10MB
VULNFLOW_MAX_DESCRIPTION_LENGTH=8000
VULNFLOW_API_KEY=local-development-only-api-key
VULNFLOW_REPORT_STORAGE_DIRECTORY=/var/lib/vulnflow/reports
VULNFLOW_WORKER_ENABLED=true
VULNFLOW_WORKER_POLL_INTERVAL=2s
VULNFLOW_WORKER_BATCH_SIZE=5
VULNFLOW_WORKER_MAX_ATTEMPTS=3
VULNFLOW_WORKER_STALE_TIMEOUT=15m
VULNFLOW_WORKER_BACKOFF=5s,30s,2m
