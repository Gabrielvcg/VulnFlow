VULNFLOW_API_URL=https://vulnflow.example.com/
# Populate this value only in the deployed, permission-restricted environment file.
VULNFLOW_API_KEY=
VULNFLOW_AGENT_ID=vps-production-01
VULNFLOW_SCAN_INTERVAL=6h
VULNFLOW_TRIVY_PATH=/usr/local/bin/trivy
VULNFLOW_AGENT_DATA_DIR=/var/lib/vulnflow-agent
VULNFLOW_AGENT_TEMP_DIR=/var/lib/vulnflow-agent/tmp
VULNFLOW_AGENT_MAX_CONCURRENT_SCANS=1
VULNFLOW_AGENT_UPLOAD_RETRY_INTERVAL=30s
VULNFLOW_TARGETS_FILE=/etc/vulnflow-agent/targets.yml
