# Copy to <VPS_DEPLOY_PATH>/runtime/.env.prod and restrict it to the deploy user.
# Do not commit the real file. Populate every blank required value before deployment.
COMPOSE_PROJECT_NAME=vulnflow

POSTGRES_DB=vulnflow
POSTGRES_USER=vulnflow
POSTGRES_PASSWORD=
VULNFLOW_API_KEY=

# The backend is reachable only from the VPS loopback interface. Host Nginx can
# proxy to this port; PostgreSQL has no published host port.
VULNFLOW_BACKEND_PORT=8080

# Stable explicit names allow an existing volume to be adopted without deletion.
# Confirm the actual VPS volume names before the first deployment.
VULNFLOW_POSTGRES_VOLUME=vulnflow-postgres-data
VULNFLOW_REPORTS_VOLUME=vulnflow-backend-reports
VULNFLOW_AGENT_VOLUME=vulnflow-agent-data

# This absolute host path is mounted read-only in the agent container.
VULNFLOW_AGENT_TARGETS_FILE=/srv/vulnflow/runtime/targets.yml
VULNFLOW_AGENT_ID=vps-production-01
VULNFLOW_SCAN_INTERVAL=6h
VULNFLOW_AGENT_MAX_CONCURRENT_SCANS=1
VULNFLOW_AGENT_UPLOAD_RETRY_INTERVAL=30s
VULNFLOW_TRIVY_TIMEOUT=15m
VULNFLOW_AGENT_MAX_REPORT_SIZE=10MB
VULNFLOW_AGENT_MAX_OUTBOX_BYTES=1GB
VULNFLOW_AGENT_MAX_OUTBOX_ITEMS=1000
VULNFLOW_AGENT_UPLOADED_RETENTION=7d

VULNFLOW_MAX_FILE_SIZE=10MB
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
