{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageReportsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCors",
        "s3:GetBucketLocation",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:PutBucketTagging",
        "s3:PutBucketPublicAccessBlock",
        "s3:DeleteBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:DeleteBucketEncryption",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::vulnflow-demo-160172542031-eu-west-1-reports"
    },
    {
      "Sid": "DestroyTemporaryReportObjects",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::vulnflow-demo-160172542031-eu-west-1-reports"
    },
    {
      "Sid": "DestroyTemporaryReportObjectVersions",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::vulnflow-demo-160172542031-eu-west-1-reports/*"
    },
    {
      "Sid": "DiscoverQueues",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "*"
    },
    {
      "Sid": "ManageVulnFlowQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ListDeadLetterSourceQueues",
        "sqs:ListQueueTags",
        "sqs:PurgeQueue",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": [
        "arn:aws:sqs:eu-west-1:160172542031:vulnflow-demo-ingestion",
        "arn:aws:sqs:eu-west-1:160172542031:vulnflow-demo-dlq"
      ]
    },
    {
      "Sid": "ManageResultsTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:UpdateTable"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:160172542031:table/vulnflow-demo-results"
    },
    {
      "Sid": "ManageProcessorFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:DeleteFunctionConcurrency",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetPolicy",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListTags",
        "lambda:ListVersionsByFunction",
        "lambda:PutFunctionConcurrency",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:160172542031:function:vulnflow-demo-processor"
    },
    {
      "Sid": "CreateAndDiscoverProcessorEventMapping",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:ListEventSourceMappings"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEqualsIfExists": {
          "lambda:FunctionArn": "arn:aws:lambda:eu-west-1:160172542031:function:vulnflow-demo-processor"
        }
      }
    },
    {
      "Sid": "TagProcessorEventMappingOnCreate",
      "Effect": "Allow",
      "Action": "lambda:TagResource",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "vulnflow",
          "aws:RequestTag/Environment": "demo",
          "aws:RequestTag/ManagedBy": "Terraform"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "Project",
            "Environment",
            "ManagedBy",
            "CostModel",
            "Owner",
            "Purpose",
            "ReviewState"
          ]
        }
      }
    },
    {
      "Sid": "ManageProcessorEventMapping",
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:eu-west-1:160172542031:event-source-mapping:*"
    },
    {
      "Sid": "DiscoverProcessorLogGroup",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "ManageProcessorLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource",
        "logs:ListTagsLogGroup",
        "logs:PutRetentionPolicy",
        "logs:TagLogGroup",
        "logs:TagResource",
        "logs:UntagLogGroup",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-1:160172542031:log-group:/aws/lambda/vulnflow-demo-processor",
        "arn:aws:logs:eu-west-1:160172542031:log-group:/aws/lambda/vulnflow-demo-processor:*"
      ]
    },
    {
      "Sid": "DiscoverDlqAlarm",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "*"
    },
    {
      "Sid": "ManageDlqAlarm",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DeleteAlarms",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": "arn:aws:cloudwatch:eu-west-1:160172542031:alarm:vulnflow-demo-dlq-visible-messages"
    },
    {
      "Sid": "ManageProcessorRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::160172542031:role/vulnflow-demo-processor-role"
    },
    {
      "Sid": "PassOnlyProcessorRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::160172542031:role/vulnflow-demo-processor-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}
