<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.vulnflow</groupId>
    <artifactId>vulnflow</artifactId>
    <version>0.4.3</version>
    <packaging>pom</packaging>

    <modules>
        <module>processing-core</module>
        <module>backend</module>
        <module>agent</module>
        <module>aws/aws-adapters</module>
        <module>aws/lambda-processor</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <aws.sdk.version>2.41.31</aws.sdk.version>
        <aws.lambda.events.version>3.16.1</aws.lambda.events.version>
        <aws.lambda.core.version>1.2.3</aws.lambda.core.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
